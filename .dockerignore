# Default-deny build context: never send the full checkout to Docker.
**
!Dockerfile
!.dockerignore
!Cargo.toml
!Cargo.lock
!LICENSE
!NOTICE.md
!src/
!src/**
!web/
!web/index.html
!web/main.js
!web/network.js
!web/style.css
!assets/
!assets/UNICODE-LICENSE.txt
!assets/ART_PROVENANCE.json
!assets/processed/
!assets/processed/*.webp
!assets/processed/game-assets.json
!assets/processed/name_font.json
!assets/processed/name_font.otf
!assets/processed/name_font-OFL.txt

# Explicit defense-in-depth exclusions, including generated local builds.
assets/original/
assets/original/**
artifacts/
artifacts/**
target/
target/**
web/pkg/
web/pkg/**
deploy/
deploy/**
scripts/
scripts/**
.git/
.git/**
**/.env
**/.env.*
**/*.env
**/*.env.*
**/secrets/
**/secrets/**
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.crt
