# Python bytecode caches and virtual environments (uv creates them on demand).
__pycache__/
*.py[cod]
.venv/

# Local tooling, logs and browser automation profiles.
node_modules/
*.log
browser-profile/

# Failed handoff draft (contains NUL bytes); not a source of truth.
/NEXT_AGENT_PROMPT.md

