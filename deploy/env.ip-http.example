# No-domain variant for deploy/compose.ip-http.yml. Copy to deploy/.env with owner-only
# permissions (0600). This example is not a deployed endpoint: 203.0.113.10 is a
# documentation address. Plain HTTP: the key and cookies are NOT encrypted.

# Exactly what the browser's address bar shows: lower-case, no path, no trailing slash.
# Port 80 must be omitted (http://203.0.113.10); any other port must be written.
NAIFROG_PUBLIC_ORIGIN=http://203.0.113.10:18080
# The host port Docker publishes; keep it equal to the port in the origin above.
NAIFROG_PUBLIC_PORT=18080

# REQUIRED: leave no example credential in version control.
# Generate 32 random bytes encoded as 64 hex characters; DEPLOY.md shows how.
# An empty value prevents Compose from starting the server.
NAIFROG_ACCESS_KEY=
NAIFROG_MAX_ROOMS=16
# MiB per conservative rolling hour, shared by HTTP files and WS outbound.
# Valid range: 64..8192. In-memory counters reset on process restart.
NAIFROG_EGRESS_MB_PER_HOUR=512
# Optional: 1 accepts a key a person picks, 6..31 bytes (only the login rate limits guard it).
# NAIFROG_ALLOW_SHORT_ACCESS_KEY=1
