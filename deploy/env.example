# Copy to deploy/.env with owner-only permissions (0600).
# Replace the domain and email. This example is not a deployed endpoint.
NAIFROG_DOMAIN=game.example.com
ACME_EMAIL=you@example.com

# REQUIRED: leave no example credential in version control.
# Generate 32 random bytes encoded as 64 hex characters; DEPLOY.md shows how.
# An empty value prevents Compose from starting the server.
NAIFROG_ACCESS_KEY=
NAIFROG_MAX_ROOMS=16
# MiB per conservative rolling hour, shared by HTTP files and WS outbound.
# Valid range: 64..8192. In-memory counters reset on process restart.
NAIFROG_EGRESS_MB_PER_HOUR=512
