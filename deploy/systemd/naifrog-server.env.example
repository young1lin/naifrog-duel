# Install as /etc/naifrog/naifrog.env, root-owned 0600.
# systemd reads this before dropping privileges to the naifrog user.
NAIFROG_BIND=127.0.0.1:18080
# Replace with the exact canonical HTTPS Origin: no path, slash, or :443.
NAIFROG_ORIGIN=https://game.example.com
# REQUIRED: use a new random 64-character hex key, never a sample key.
NAIFROG_ACCESS_KEY=
# This directory must contain web/ (including pkg/) and assets/processed/.
NAIFROG_ASSET_ROOT=/opt/naifrog
NAIFROG_MAX_ROOMS=16
NAIFROG_PROXY_IPS=127.0.0.1
NAIFROG_EGRESS_MB_PER_HOUR=512
NAIFROG_ALLOW_INSECURE_PUBLIC_HTTP=0
